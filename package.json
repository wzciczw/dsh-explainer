{
  "name": "dsh-explainer",
  "version": "0.3.0",
  "description": "Zero-friction quick ask for DeepSeek Harness: select text in chat, Markdown/code, rendered HTML reports, or the right-sidebar editor and get a fast, isolated, one-shot explanation that follows the main model and never writes to the main session.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/host/index.js",
  "types": "./lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "PREVIEW-SELECTION.md",
    "LICENSE",
    "assets/icon-180.png",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0"
  },
  "author": {
    "name": "wzciczw",
    "url": "https://github.com/wzciczw"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzciczw/dsh-explainer.git"
  },
  "homepage": "https://github.com/wzciczw/dsh-explainer#readme",
  "bugs": {
    "url": "https://github.com/wzciczw/dsh-explainer/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "quick-ask",
    "explain",
    "translate",
    "selection",
    "html-preview",
    "selection-bridge",
    "agent-tools",
    "fast",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  }
}
